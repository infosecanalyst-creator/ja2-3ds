# TrimUI Brick (tg5040 platform): aarch64, glibc 2.23 baseline, via zig cc
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
set(CMAKE_C_COMPILER   @BIN@/zcc)
set(CMAKE_CXX_COMPILER @BIN@/zcxx)
set(CMAKE_AR           @BIN@/zar)
set(CMAKE_RANLIB       @BIN@/zranlib)
set(CMAKE_C_FLAGS_INIT   "-I@SYS@/include")
set(CMAKE_CXX_FLAGS_INIT "-I@SYS@/include")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH @SYS@)
