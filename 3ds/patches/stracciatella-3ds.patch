+/// File length via lseek (fstat is unreliable on the 3DS); restores the position.
+fn file_len(file: &std::fs::File) -> std::io::Result<u64> {
+    use std::io::{Seek, SeekFrom};
+    let mut f = file;
+    let cur = f.stream_position()?;
+    let end = f.seek(SeekFrom::End(0))?;
+    f.seek(SeekFrom::Start(cur))?;
+    Ok(end)
+}
