+extern "C" int SDL_main(int argc, char* argv[])
+{
+	// Launched by path (Azahar) argc is 0 and argv is NULL; the Rust option parser needs a real argv
+	static char argv0[] = "ja2";
+	static char* fakeArgv[] = { argv0, nullptr };
+	if (argc <= 0 || !argv) { argc = 1; argv = fakeArgv; }
+	mkdir("/3ds", 0777); mkdir("/3ds/ja2", 0777); mkdir("/3ds/ja2/tmp", 0777);
+	setenv("TMPDIR", "/3ds/ja2/tmp", 1); // the 3DS has no /tmp; Rust's temp_dir() reads TMPDIR
+	osSetSpeedupEnable(true); // 804 MHz from the very start (loading is CPU bound)
+	mkdir(N3DS_DIR, 0777);
+	chdir(N3DS_DIR);
+	const char* logPath = N3DS_DIR "/console.txt";
+	freopen(logPath, "w", stdout);
+	freopen(logPath, "a", stderr);
+	setvbuf(stdout, nullptr, _IONBF, 0);
+	setvbuf(stderr, nullptr, _IONBF, 0);
+	printf("[3ds] JA2 Stracciatella 3DS port starting, argc=%d argv0=%s\n", argc, argc > 0 ? argv[0] : "?");
+	{ // probe: what does stat() report on this system?
+		const char* probes[] = { "/3ds/ja2/gamedata", "/3ds/ja2/gamedata/Data", "/3ds/ja2/gamedata/data", "/3ds/ja2/gamedata/Data/Sounds.slf", "/3ds/ja2/gamedata/Data/sounds.slf" };
+		for (const char* p : probes) {
+			struct stat sb; memset(&sb, 0, sizeof sb);
+			int r = stat(p, &sb);
+			printf("[probe] stat(%s) = %d mode=%o size=%lld\n", p, r, (unsigned)sb.st_mode, (long long)sb.st_size);
+		}
+	}
+
+	atexit([] { printf("[3ds] atexit: process is exiting\n"); });
+	std::set_new_handler(N3DS_NewHandler);
+	N3DS_LogMem("startup");
+	int rc = 1;
+	std::string why;
+	try {
+		rc = ja2_main(argc, argv);
+		if (rc != 0) why = "Game exited with code " + std::to_string(rc);
+	} catch (const std::exception& e) {
+		why = std::string("Exception: ") + e.what();
+	} catch (...) {
+		why = "Unknown exception";
+	}
+	printf("[3ds] exit: rc=%d %s\n", rc, why.c_str());
+	if (rc != 0) {
+		struct stat sb;
+		const char* gameLog = N3DS_DIR "/ja2.log";
+		(void)gameLog; (void)sb; ShowTextAndWait(why, logPath);
+	}
+	return rc;
+}
