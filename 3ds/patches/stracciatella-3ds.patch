+// ================================================================ click sound (very quiet, own ndsp channel)
+static s16* g_clickBuf = nullptr;
+static ndspWaveBuf g_clickWave;
+static bool g_clickReady = false;
+static const int kClickCh = 23;
+static void ClickInit()
+{
+	if (g_clickReady) return;
+	if (R_FAILED(ndspInit())) return; // ref-counted; SDL audio also uses ndsp
+	const int n = 22050 * 6 / 1000; // 6 ms
+	g_clickBuf = (s16*)linearAlloc(n * sizeof(s16));
+	if (!g_clickBuf) return;
+	u32 r = 12345;
+	for (int i = 0; i < n; ++i) { r = r * 1103515245 + 12345; const float env = 1.0f - (float)i / n; g_clickBuf[i] = (s16)((int)((r >> 16) & 0x7FF) - 0x400) * env * env; }
+	DSP_FlushDataCache(g_clickBuf, n * sizeof(s16));
+	ndspChnReset(kClickCh);
+	ndspChnSetInterp(kClickCh, NDSP_INTERP_NONE);
+	ndspChnSetRate(kClickCh, 22050);
+	ndspChnSetFormat(kClickCh, NDSP_FORMAT_MONO_PCM16);
+	float mix[12] = { 0.18f, 0.18f }; // subtle
+	ndspChnSetMix(kClickCh, mix);
+	memset(&g_clickWave, 0, sizeof g_clickWave);
+	g_clickWave.data_vaddr = g_clickBuf; g_clickWave.nsamples = n;
+	g_clickReady = true;
+}
+static void Click()
+{
+	ClickInit();
+	if (!g_clickReady) return;
+	if (g_clickWave.status == NDSP_WBUF_PLAYING || g_clickWave.status == NDSP_WBUF_QUEUED) ndspChnWaveBufClear(kClickCh);
+	g_clickWave.status = NDSP_WBUF_FREE;
+	ndspChnWaveBufAdd(kClickCh, &g_clickWave);
+}
