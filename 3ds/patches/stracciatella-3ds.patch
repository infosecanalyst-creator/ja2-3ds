+static inline u16 avg565(u16 a, u16 b) { return (u16)(((a & 0xF7DE) >> 1) + ((b & 0xF7DE) >> 1) + (a & b & 0x0821)); }
+
+// 640x480 game frame -> 320x240 at (ox, 0) on canvas, 2x2 box filter
+static void DrawGameHalf(const Canvas& c, int ox, SDL_Surface* screen)
+{
+	const int spitch = screen->pitch / 2;
+	const u16* src = (const u16*)screen->pixels;
+	for (int y = 0; y < 240; ++y) {
+		const u16* r0 = src + (y * 2) * spitch;
+		const u16* r1 = r0 + spitch;
+		for (int x = 0; x < 320; ++x) {
+			const int sx = x * 2;
+			if (u16* p = PxP(c, ox + x, y)) *p = avg565(avg565(r0[sx], r0[sx + 1]), avg565(r1[sx], r1[sx + 1]));
+		}
+	}
+}
