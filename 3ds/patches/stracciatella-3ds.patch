+	SDL_EventState(SDL_FINGERDOWN, st); SDL_EventState(SDL_FINGERUP, st); SDL_EventState(SDL_FINGERMOTION, st);
+	if (on) { if (FILE* f = fopen(N3DS_DIR "/.swap", "w")) fclose(f); } else remove(N3DS_DIR "/.swap");
+}
