+namespace {
+struct Canvas { u16* fb; int w, h; };
+inline u16 C565(int r, int g, int b) { return (u16)(((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3)); }
+Canvas CanvasFor(gfxScreen_t scr) { u16 fw, fh; u16* fb = (u16*)gfxGetFramebuffer(scr, GFX_LEFT, &fw, &fh); return { fb, (int)fh, (int)fw }; }
+inline u16* PxP(const Canvas& c, int x, int y) { return ((unsigned)x < (unsigned)c.w && (unsigned)y < (unsigned)c.h) ? &c.fb[x * c.h + (c.h - 1 - y)] : nullptr; }
+void Fill(const Canvas& c, int x, int y, int w, int h, u16 col)
+{
+	if (x < 0) { w += x; x = 0; } if (y < 0) { h += y; y = 0; }
+	if (x + w > c.w) w = c.w - x; if (y + h > c.h) h = c.h - y;
+	for (int i = x; i < x + w; ++i) { u16* colp = &c.fb[i * c.h + (c.h - y - h)]; for (int j = 0; j < h; ++j) colp[j] = col; }
+}
+inline u16 Blend(u16 bg, u16 fg, int a)
+{
+	const int r = ((fg >> 11) * a + (bg >> 11) * (255 - a)) / 255;
+	const int g = (((fg >> 5) & 63) * a + ((bg >> 5) & 63) * (255 - a)) / 255;
+	const int b = ((fg & 31) * a + (bg & 31) * (255 - a)) / 255;
+	return (u16)((r << 11) | (g << 5) | b);
+}
+int TextW(const char* s, const N3DSFont& f) { int w = 0; for (; *s; ++s) { unsigned c = (u8)*s; if (c < 32 || c > 126) c = '?'; w += f.g[c - 32].adv; } return w; }
+// Draws text with its top at y. maxw > 0: shortens with "..." so it can never run past the box.
+int Text(const Canvas& cv, int x, int y, const char* s, u16 col, const N3DSFont& f = kFontSans, int maxw = -1)
+{
+	std::string tmp;
+	if (maxw > 0 && TextW(s, f) > maxw) {
+		tmp = s; const int ell = TextW("...", f);
+		while (!tmp.empty() && TextW(tmp.c_str(), f) + ell > maxw) tmp.pop_back();
+		tmp += "..."; s = tmp.c_str();
+	}
+	const int x0 = x;
+	for (; *s; ++s) {
+		unsigned c = (u8)*s; if (c < 32 || c > 126) c = '?';
+		const N3DSGlyph& g = f.g[c - 32];
+		const u8* a = f.a + g.off;
+		for (int j = 0; j < g.h; ++j) for (int i = 0; i < g.w; ++i) {
+			const int al = a[j * g.w + i]; if (!al) continue;
+			if (u16* p = PxP(cv, x + g.x + i, y + g.y + j)) *p = al >= 250 ? col : Blend(*p, col, al);
+		}
+		x += g.adv;
+	}
+	return x - x0;
+}
+const u16 kBg = C565(14, 20, 40), kPanel = C565(26, 36, 64), kText = C565(230, 230, 230), kTitle = C565(255, 214, 110),
+          kDim = C565(150, 160, 180), kSel = C565(50, 80, 140), kBtn = C565(120, 60, 30), kBtnHi = C565(190, 100, 45),
+          kBarBg = C565(40, 44, 70);
+} // namespace
