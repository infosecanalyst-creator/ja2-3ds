+// Generated from docs/manual.txt by tools/gen_manual.py -- edit the .txt
+#pragma once
+struct N3DSManualPage { const char* title; int n; const char* lines[25]; };
+static const N3DSManualPage kN3DSManual[] = {
+  { "CONTENTS", 22, { "Jagged Alliance 2 - New 3DS edition", "Engine: JA2 Stracciatella. Data: your JA2 Gold.", "", " 1  Controls", " 2  The two screens", " 3  Getting started", " 4  Hiring mercenaries", " 5  Tactical combat", " 6  Shooting and aiming", " 7  The strategic map", " 8  Assignments and militia", " 9  Money, mines and towns", "10  Inventory and items", "11  Saving and options", "12  Tips for a first campaign", "", "In this manual:", "  Circle Pad / C-Stick   scroll the text", "  D-Pad                  move between sections", "  L / R                  previous / next section", "  Tap a section on the touch screen to jump.", "  B or START closes the manual." } },
+  { "1. CONTROLS  (1/2): STYLUS", 15, { "The touch screen is the whole game. The stylus", "is the mouse: tap = left click, drag = drag.", "For a right click, press B (it clicks at the", "cursor, i.e. where you last touched).", "", "In battle, a tap does not act at once. JA2's", "touch buttons pop up beside the target:", "  Do     confirm the move / shot / action", "  Run    move at a run          (moves)", "  Item   use the item in hand   (moves)", "  Aim    add an aim click       (shots)", "  Mode   single / burst fire    (shots)", "  X      cancel", "You can also steer the cursor with the Circle", "Pad and click with A / B." } },
+  { "1. CONTROLS  (2/2): BUTTONS", 14, { "Circle Pad / C    move the cursor", "A                 left click at the cursor", "B                 right click at the cursor", "D-pad             scroll the map", "X                 next merc (Space)", "                  map screen: pause / resume time", "Y                 strategic map  (M)", "L                 stance down (crouch / prone)", "R                 stance up / climb onto a roof", "ZL                swap the screens", "ZR                tap: roof level, hold: END TURN", "START             Esc: cancel, close windows,", "                  map screen: enter the sector", "SELECT            this manual" } },
+  { "2. THE TWO SCREENS", 14, { "BOTTOM (touch): the complete game. Everything", "you click is here; the stylus is the mouse.", "", "TOP: the dashboard. It shows the date, time", "and sector, the selected merc's health,", "energy, morale, action points and skills,", "and the controls for the screen you are on.", "", "SWAP: press ZL at any time to put the game on", "the top screen and the dashboard on the touch", "screen. Press ZL again (or tap the button at", "the foot of the touch screen) to swap back.", "The choice is saved. The stylus is off while", "the game is on top. The 3D slider is not used." } },
+  { "3. GETTING STARTED  (1/2)", 11, { "The tiny nation of Arulco is ruled by Queen", "Deidranna. Her exiled husband Enrico", "Chivaldori pays you to free it, town by town.", "", "New game: choose difficulty (Novice is a fair", "first try), game style (Realistic, or Sci-Fi", "with creatures) and Save Anytime / Iron Man.", "", "You start in the laptop, in your office. The", "clock does not run until your first team has", "landed, so take your time here." } },
+  { "3. GETTING STARTED  (2/2)", 12, { "First steps:", " 1. Read Enrico's e-mail (Mail button).", " 2. Hire 3 - 6 mercs on the A.I.M. site, or", "    make your own on I.M.P. (chapter 4).", " 3. Close the laptop. On the map, your team", "    is in the helicopter heading for Omerta.", " 4. Press START (Esc) or tap Omerta to land.", " 5. In Omerta, find the rebels and speak to", "    Fatima, then Dimitri - they give you the", "    next lead. Drassen (to the east) has an", "    airport: taking it lets new mercs fly in", "    closer to the front." } },
+  { "4. HIRING MERCENARIES  (1/2)", 13, { "A.I.M. (laptop > A.I.M.): the elite agency.", "  Members > tap a face for stats and price.", "  Contracts are 1 day, 1 week or 2 weeks;", "  longer is cheaper per day. Mercs with", "  high Leadership and Wisdom are good early;", "  a medic (Medical skill) is essential.", "  Some mercs refuse to work with people they", "  dislike, or until you prove yourself.", "M.E.R.C. (Speck's site) opens a few days in:", "  cheaper, paid daily, a mixed bag.", "I.M.P.: create your own merc ($3000). A", "  personality quiz decides skills and stats.", "  Typing a name opens the 3DS keyboard." } },
+  { "4. HIRING MERCENARIES  (2/2)", 15, { "Equipment arrives with the merc (pick \"buy", "equipment\" on A.I.M.). Bobby Ray's (laptop)", "sells guns, ammo and armour by mail; orders", "are delivered to Drassen airport once you", "hold it.", "", "Pay attention to:", "  Health / Agility / Dexterity  - survival,", "      speed and accuracy.", "  Marksmanship                  - hitting.", "  Medical, Mechanical,", "  Explosives, Leadership        - jobs.", "  Experience level              - interrupts.", "Morale drops when mercs are hurt, unpaid or", "working with people they dislike." } },
+  { "5. TACTICAL COMBAT  (1/2)", 14, { "In a sector with no enemies in sight, time", "runs in real time. When either side spots", "the other, the game switches to TURNS.", "", "ACTION POINTS (AP): each merc gets AP every", "turn. Walking, kneeling, opening doors,", "reloading and shooting all cost AP. The cost", "shows next to the cursor before you click.", "Unused AP carry a small bonus into the next", "turn.", "", "ZR (D) ends your turn. Enemies then move.", "INTERRUPTS: a merc who spots an enemy moving", "may get to act in the middle of their turn." } },
+  { "5. TACTICAL COMBAT  (2/2)", 14, { "Moving: tap a tile. The path and its AP cost", "  show; tap Do (or Run) to go, X to cancel.", "STANCE (L / R): standing, crouched, prone.", "  Crouched and prone mercs are harder to hit", "  and aim better, but cost more AP to move.", "Climbing: R next to a low building climbs", "  onto the roof; ZR switches the cursor to", "  roof level so you can pick roof tiles.", "Doors: tap a door, then Do, to open it; with", "  the cursor on a door B gives options", "  (lockpick, force, explosives, examine).", "Healing: bandage bleeding mercs at once", "  (first aid kit in hand, then the merc).", "  Bleeding mercs lose health every turn." } },
+  { "6. SHOOTING AND AIMING", 15, { "With a gun in hand, tap an enemy. The chance", "to hit shows, with Aim / Mode / Do / X.", "  Aim   each tap adds an aim click: costs AP,", "        raises the chance to hit", "  Mode  single shot or burst (if the gun has", "        one). Bursts use more ammo but hit", "        more often at short range.", "  Do    fire", "With buttons: move the cursor onto the enemy,", "B adds aim, A fires.", "", "Range and light matter: night, smoke and", "distance hurt accuracy. Head shots kill but", "are hard; aim at the body.", "Grenades: put one in hand, then target a tile." } },
