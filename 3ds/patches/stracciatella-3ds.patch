diff --git a/src/sgp/n3ds/N3DS_Dashboard.cc b/src/sgp/n3ds/N3DS_Dashboard.cc
new file mode 100644
index 0000000..0fd3887
--- /dev/null
+++ b/src/sgp/n3ds/N3DS_Dashboard.cc
@@ -0,0 +1,44 @@
+// Top-screen dashboard content for the 3DS port (game side: reads JA2 state)
+#ifdef JA2_3DS
+#include "N3DS_Dashboard.h"
+#include "JAScreens.h"
+#include "ScreenIDs.h"
+#include "Overhead.h"
+#include "Soldier_Control.h"
+#include "Game_Clock.h"
+#include "Map_Information.h"
+#include "StrategicMap.h"
+
+N3DSScreen N3DS_CurrentScreen()
+{
+	switch (guiCurrentScreen) {
+		case MAINMENU_SCREEN: return N3DS_SCR_MENU;
+		case GAME_SCREEN:     return N3DS_SCR_TACTICAL;
+		case MAP_SCREEN:      return N3DS_SCR_MAP;
+		case LAPTOP_SCREEN:   return N3DS_SCR_LAPTOP;
+		case INTRO_SCREEN:    return N3DS_SCR_INTRO;
+		default:              return N3DS_SCR_OTHER;
+	}
+}
+
+void N3DS_GetDashboard(N3DSDash& d)
+{
+	d = N3DSDash();
+	d.screen = N3DS_CurrentScreen();
+	d.inGame = d.screen == N3DS_SCR_TACTICAL || d.screen == N3DS_SCR_MAP || d.screen == N3DS_SCR_LAPTOP;
+	if (!d.inGame) return;
+	d.time = gswzWorldTimeStr.to_std_string();
+	if (gfWorldLoaded && gWorldSector.x > 0) d.sector = GetSectorIDString(gWorldSector, FALSE).to_std_string();
+	const SOLDIERTYPE* s = g_selected_man;
+	if (!s || !s->bActive) return;
+	d.hasMerc = true;
+	d.name = s->name.to_std_string();
+	d.level = s->bExpLevel;
+	d.life = s->bLife; d.lifeMax = s->bLifeMax > 0 ? s->bLifeMax : 100;
+	d.breath = s->bBreath; d.breathMax = s->bBreathMax > 0 ? s->bBreathMax : 100;
+	d.morale = s->bMorale;
+	d.ap = d.screen == N3DS_SCR_TACTICAL ? s->bActionPoints : -1;
+	const int st[8] = { s->bAgility, s->bDexterity, s->bStrength, s->bWisdom, s->bMarksmanship, s->bMedical, s->bMechanical, s->bExplosive };
+	for (int i = 0; i < 8; ++i) d.stats[i] = st[i];
+}
+#endif
diff --git a/src/sgp/n3ds/N3DS_Dashboard.h b/src/sgp/n3ds/N3DS_Dashboard.h
new file mode 100644
index 0000000..e1d2f98
--- /dev/null
+++ b/src/sgp/n3ds/N3DS_Dashboard.h
@@ -0,0 +1,15 @@
+#pragma once
+#include <string>
+// What the top-screen dashboard shows (filled from game state by N3DS_Dashboard.cc)
+enum N3DSScreen { N3DS_SCR_OTHER, N3DS_SCR_MENU, N3DS_SCR_TACTICAL, N3DS_SCR_MAP, N3DS_SCR_LAPTOP, N3DS_SCR_INTRO };
+struct N3DSDash {
+	N3DSScreen screen = N3DS_SCR_OTHER;
+	bool inGame = false;
+	std::string time, sector;
+	bool hasMerc = false;
+	std::string name;
+	int level = 0, life = 0, lifeMax = 1, breath = 0, breathMax = 1, morale = 0, ap = -1;
+	int stats[8] = {}; // AGI DEX STR WIS MRK MED MEC EXP
+};
+void N3DS_GetDashboard(N3DSDash& d);
+N3DSScreen N3DS_CurrentScreen();
