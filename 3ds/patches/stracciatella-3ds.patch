+// ---------------------------------------------------------------- dashboard
+static const char* kStatNames[8] = { "AGI", "DEX", "STR", "WIS", "MRK", "MED", "MEC", "EXP" };
+static void Bar(const Canvas& c, int x, int y, int w, const char* label, int v, int max)
+{
+	Text(c, x, y, label, kDim, kFontSans);
+	const int bx = x + 56, bw = w - 56 - 62;
+	Fill(c, bx, y + 2, bw, 10, kBarBg);
+	if (v < 0) v = 0; if (v > max) v = max;
+	const int pct = max ? v * 100 / max : 0;
+	const u16 col = pct > 60 ? C565(70, 190, 90) : pct > 30 ? C565(225, 180, 50) : C565(215, 60, 50);
+	Fill(c, bx, y + 2, max ? bw * v / max : 0, 10, col);
+	char num[16]; snprintf(num, sizeof num, "%d/%d", v, max);
+	Text(c, bx + bw + 6, y, num, kText, kFontSans, 56);
+}
+static void DrawDashboard(const Canvas& c, bool withSwapButton)
+{
+	static N3DSDash d;
+	static u64 last = 0;
+	const u64 now = svcGetSystemTick();
+	if (now - last > SYSCLOCK_ARM11 / 4 || last == 0) { N3DS_GetDashboard(d); last = now; }
+	const int W = c.w;
+	Fill(c, 0, 0, W, c.h, kBg);
+	// header
+	Fill(c, 0, 0, W, 20, kSel);
+	Text(c, 6, 3, "JAGGED ALLIANCE 2", kTitle, kFontBold);
+	const char* where = d.screen == N3DS_SCR_MENU ? "Main menu" : d.screen == N3DS_SCR_TACTICAL ? "Tactical" :
+	                    d.screen == N3DS_SCR_MAP ? "Strategic map" : d.screen == N3DS_SCR_LAPTOP ? "Laptop" : "";
+	Text(c, W - 6 - TextW(where, kFontSans), 4, where, kText, kFontSans);
+	int y = 26;
+	if (d.inGame) {
+		Text(c, 6, y, d.time.c_str(), kTitle, kFontBold, W / 2);
+		if (!d.sector.empty()) { const std::string sct = "Sector " + d.sector; Text(c, W - 6 - std::min(TextW(sct.c_str(), kFontSans), W / 2 - 12), y + 1, sct.c_str(), kText, kFontSans, W / 2 - 12); }
+		y += 20;
+	}
+	if (d.hasMerc) {
+		Fill(c, 4, y, W - 8, 1, kPanel);
+		y += 4;
+		char lvl[24]; snprintf(lvl, sizeof lvl, "Level %d", d.level);
+		const int lw = TextW(lvl, kFontSans);
+		Text(c, 6, y, d.name.c_str(), kText, kFontBig, W - 24 - lw);
+		Text(c, W - 6 - lw, y + 5, lvl, kDim, kFontSans);
+		y += 26;
+		Bar(c, 6, y, W - 12, "Health", d.life, d.lifeMax); y += 17;
+		Bar(c, 6, y, W - 12, "Energy", d.breath, d.breathMax); y += 17;
+		Bar(c, 6, y, W - 12, "Morale", d.morale, 100); y += 19;
+		if (d.ap >= 0) { char ap[32]; snprintf(ap, sizeof ap, "Action points: %d", d.ap); Text(c, 6, y, ap, kTitle, kFontBold); y += 18; }
+		const int colw = (W - 12) / 4;
+		for (int i = 0; i < 8; ++i) {
+			char st[16]; snprintf(st, sizeof st, "%s %d", kStatNames[i], d.stats[i]);
+			Text(c, 6 + (i % 4) * colw, y + (i / 4) * 15, st, kText, kFontMono, colw - 4);
+		}
+		y += 32;
+	} else if (d.screen == N3DS_SCR_MENU || !d.inGame) {
+		y += 20;
+		const char* l1 = d.screen == N3DS_SCR_MENU ? "Tap a menu item to choose it." : "Loading...";
+		Text(c, (W - TextW(l1, kFontBold)) / 2, y, l1, kText, kFontBold); y += 22;
+		const char* l2 = "SELECT opens the manual at any time.";
+		Text(c, (W - TextW(l2, kFontSans)) / 2, y, l2, kDim, kFontSans);
+	}
+	// controls strip
+	const int stripH = withSwapButton ? 58 : 36, sy = c.h - stripH;
+	Fill(c, 0, sy, W, stripH, kPanel);
+	const char *a, *b;
+	switch (d.screen) {
+		case N3DS_SCR_TACTICAL: a = "Tap=click  B=right click  ZR hold=end turn"; b = "L/R stance   X next merc   Y map   SELECT manual"; break;
+		case N3DS_SCR_MAP:      a = "Tap = click   B = right click   X = time on/off"; b = "START enter sector   SELECT manual"; break;
+		default:                a = "Tap or A = click   B = right click"; b = "Circle Pad = cursor   SELECT = manual"; break;
+	}
+	Text(c, 6, sy + 3, a, kText, kFontSans, W - 12);
+	Text(c, 6, sy + 18, b, kDim, kFontSans, W - 12);
+	if (withSwapButton) {
+		Fill(c, 6, c.h - 22, W - 12, 18, kBtn);
+		const char* t = "Tap here: put the game back on this screen";
+		Text(c, (W - std::min(TextW(t, kFontSans), W - 20)) / 2, c.h - 20, t, kText, kFontSans, W - 20);
+	}
+}
+
+void N3DS_Present(SDL_Surface* screen, int cx, int cy)
+{
+	if (!g_ready || !screen) return;
+	g_bootDone = true;
+	if (!g_swap) {
+		DrawGameHalf(CanvasFor(GFX_BOTTOM), 0, screen);
+		DrawDashboard(CanvasFor(GFX_TOP), false);
+	} else {
+		Canvas t = CanvasFor(GFX_TOP);
+		Fill(t, 0, 0, 40, 240, 0); Fill(t, 360, 0, 40, 240, 0);
+		DrawGameHalf(t, 40, screen);
+		DrawDashboard(CanvasFor(GFX_BOTTOM), true);
+	}
+	gfxFlushBuffers();
+	gfxSwapBuffers();
+}
+
+// ---------------------------------------------------------------- boot + error screens
+void N3DS_DrawBootLines(char (*l)[64], int n)
+{
+	static bool fmt = false;
+	if (!fmt) { // SDL opens the screens as RGBA8; our renderer writes RGB565
+		fmt = true;
+		gfxSetScreenFormat(GFX_TOP, GSP_RGB565_OES); gfxSetScreenFormat(GFX_BOTTOM, GSP_RGB565_OES);
+		gfxSetDoubleBuffering(GFX_TOP, true); gfxSetDoubleBuffering(GFX_BOTTOM, true);
+	}
+	for (int buf = 0; buf < 2; ++buf) {
+		Canvas t = CanvasFor(GFX_TOP);
+		Fill(t, 0, 0, t.w, t.h, kBg);
+		Text(t, 6, 4, "Jagged Alliance 2 - loading", kTitle, kFontBold);
+		const int first = n > 14 ? n - 14 : 0;
+		for (int i = first; i < n; ++i) Text(t, 6, 24 + (i - first) * 15, l[i], kText, kFontMono, t.w - 12);
+		Canvas b = CanvasFor(GFX_BOTTOM);
+		Fill(b, 0, 0, b.w, b.h, kBg);
+		const char* m = "Loading game data from the SD card";
+		Text(b, (b.w - TextW(m, kFontSans)) / 2, 112, m, kDim, kFontSans);
+		gfxFlushBuffers(); gfxSwapBuffers();
+	}
+}
+
+static void ShowTextAndWait(const std::string& title, const char* path)
+{
+	SDL_Quit();
+	gfxInitDefault();
+	gfxSetScreenFormat(GFX_TOP, GSP_RGB565_OES); gfxSetScreenFormat(GFX_BOTTOM, GSP_RGB565_OES);
+	std::string all;
+	if (FILE* f = fopen(path, "r")) { char buf[512]; while (fgets(buf, sizeof buf, f)) all += buf; fclose(f); }
+	auto wrap = [](const std::string& in, int maxw, const N3DSFont& f) {
+		std::vector<std::string> out; size_t st = 0;
+		while (st <= in.size()) {
+			size_t e = in.find('\n', st); if (e == std::string::npos) e = in.size();
+			std::string l = in.substr(st, e - st);
+			do { size_t n = l.size(); while (n > 1 && TextW(l.substr(0, n).c_str(), f) > maxw) --n; out.push_back(l.substr(0, n)); l = l.size() > n ? "  " + l.substr(n) : ""; } while (!l.empty());
+			st = e + 1;
+		}
+		return out;
+	};
+	const auto lines = wrap(all, 388, kFontMono);
+	const auto wt = wrap(title, 388, kFontBold);
+	while (aptMainLoop()) {
+		hidScanInput();
+		if (hidKeysDown() & (KEY_START | KEY_A)) break;
+		Canvas t = CanvasFor(GFX_TOP);
+		Fill(t, 0, 0, t.w, t.h, C565(60, 10, 10));
+		int y = 4;
+		for (auto& l : wt) { Text(t, 6, y, l.c_str(), kTitle, kFontBold); y += 16; }
+		y += 4;
+		const int room = (t.h - y) / 14;
+		const int first = (int)lines.size() > room ? (int)lines.size() - room : 0;
+		for (int i = first; i < (int)lines.size(); ++i, y += 14) Text(t, 6, y, lines[i].c_str(), kText, kFontMono);
+		Canvas b = CanvasFor(GFX_BOTTOM);
+		Fill(b, 0, 0, b.w, b.h, kBg);
+		Text(b, 12, 80, "JA2 3DS port - stopped", kTitle, kFontBold);
+		Text(b, 12, 104, "Log: sdmc:/3ds/ja2/console.txt", kText, kFontSans);
+		Text(b, 12, 124, "Press START to exit.", kText, kFontSans);
+		gfxFlushBuffers(); gfxSwapBuffers(); gspWaitForVBlank();
+	}
+	gfxExit();
+}
+
+// ---------------------------------------------------------------- manual
+struct ManLine { const char* text; bool heading; };
+static std::vector<ManLine> SectionLines(int ch)
+{
+	std::vector<ManLine> v;
+	const int first = kN3DSManualChapters[ch].page;
+	const int last = ch + 1 < kN3DSManualChapterCount ? kN3DSManualChapters[ch + 1].page : kN3DSManualPages;
+	for (int p = first; p < last; ++p) {
+		if (p != first) v.push_back({ "", false });
+		v.push_back({ kN3DSManual[p].title, true });
+		for (int i = 0; i < kN3DSManual[p].n; ++i) v.push_back({ kN3DSManual[p].lines[i] ? kN3DSManual[p].lines[i] : "", false });
+	}
+	return v;
+}
+static const int kManRows = 14, kManLineH = 15;
+static const int kBtnSwap = 100, kBtnOpts = 101;
+
+static void DrawManualTop(int scroll, const std::vector<ManLine>& lines)
+{
+	Canvas t = CanvasFor(GFX_TOP);
+	Fill(t, 0, 0, t.w, t.h, kBg);
+	for (int r = 0; r < kManRows && scroll + r < (int)lines.size(); ++r) {
+		const ManLine& l = lines[scroll + r];
+		if (l.heading) Text(t, 8, 3 + r * kManLineH, l.text, kTitle, kFontBold, t.w - 20);
+		else Text(t, 8, 4 + r * kManLineH, l.text, kText, kFontMono, t.w - 20);
+	}
+	if ((int)lines.size() > kManRows) {
+		const int barH = t.h - 22, thumb = barH * kManRows / (int)lines.size();
+		Fill(t, t.w - 6, 2, 4, barH, kSel);
+		Fill(t, t.w - 6, 2 + barH * scroll / (int)lines.size(), 4, thumb < 8 ? 8 : thumb, kDim);
+	}
+	Fill(t, 0, t.h - 18, t.w, 18, kSel);
+	Text(t, 8, t.h - 16, "Stick: scroll    D-Pad / L / R: section    B: close", kText, kFontSans, t.w - 16);
+}
+static void DrawManualBottom(int ch, int sel, int pressed)
+{
+	Canvas b = CanvasFor(GFX_BOTTOM);
+	Fill(b, 0, 0, b.w, b.h, kBg);
+	Text(b, 6, 2, "MANUAL  -  tap a section", kTitle, kFontBold);
+	for (int i = 0; i < kN3DSManualChapterCount; ++i) {
+		const int y = 20 + i * 14;
+		const bool pr = i == pressed;
+		if (pr) Fill(b, 3, y + 1, b.w - 6, 12, kTitle);
+		else if (i == ch) Fill(b, 0, y, b.w, 14, kSel);
+		if (i == sel && !pr) { Fill(b, 0, y, 3, 14, kTitle); Fill(b, b.w - 3, y, 3, 14, kTitle); }
+		char line[64];
+		if (i == 0) snprintf(line, sizeof line, "%s", kN3DSManualChapters[i].name); else snprintf(line, sizeof line, "%d.  %s", i, kN3DSManualChapters[i].name);
+		Text(b, pr ? 11 : 10, y + (pr ? 1 : 0), line, pr ? kBg : kText, kFontSans, b.w - 24);
+	}
+	auto button = [&](int id, int x, int w, const char* label) {
+		const int y = b.h - 30, h = 26; const bool pr = id == pressed;
+		if (pr) Fill(b, x + 2, y + 2, w - 4, h - 4, kTitle); else Fill(b, x, y, w, h, kBtn);
+		if (id == sel && !pr) { Fill(b, x, y, w, 2, kTitle); Fill(b, x, y + h - 2, w, 2, kTitle); }
+		const int tw = std::min(TextW(label, kFontSans), w - 8);
+		Text(b, x + (w - tw) / 2 + (pr ? 1 : 0), y + 7 + (pr ? 1 : 0), label, pr ? kBg : kText, kFontSans, w - 8);
+	};
+	button(kBtnSwap, 4, 152, g_swap ? "Game to touch screen" : "Swap screens");
+	button(kBtnOpts, 164, 152, "Save / Load / Quit");
+}
+
+static void N3DS_RunManual(int startChapter = 0)
+{
+	int ch = startChapter, scroll = 0, sel = startChapter;
+	int pressed = -1, pressFrames = 0, action = 0; // action: 1 = options, 2 = swap
+	std::vector<ManLine> lines = SectionLines(ch);
+	hidSetRepeatParameters(18, 4);
+	auto go = [&](int c) { ch = c; sel = c; scroll = 0; lines = SectionLines(ch); };
+	auto press = [&](int id) { pressed = id; pressFrames = 6; Click(); };
+	while (aptMainLoop()) {
+		hidScanInput();
+		const u32 down = hidKeysDown(), rep = hidKeysDownRepeat();
+		if (!pressFrames && (down & (KEY_B | KEY_START | KEY_SELECT))) break;
+		const int maxScroll = (int)lines.size() > kManRows ? (int)lines.size() - kManRows : 0;
+		if (rep & (KEY_CPAD_DOWN | KEY_CSTICK_DOWN)) { if (scroll < maxScroll) ++scroll; }
+		if (rep & (KEY_CPAD_UP | KEY_CSTICK_UP)) { if (scroll > 0) --scroll; }
+		if (rep & KEY_DDOWN) { if (sel < kN3DSManualChapterCount - 1) go(sel + 1); else if (sel < kN3DSManualChapterCount) sel = kBtnSwap; }
+		if (rep & KEY_DUP) { if (sel >= kBtnSwap) sel = ch; else if (sel > 0) go(sel - 1); }
+		if ((rep & KEY_DRIGHT) && sel == kBtnSwap) sel = kBtnOpts;
+		if ((rep & KEY_DLEFT) && sel == kBtnOpts) sel = kBtnSwap;
+		if (down & KEY_R) { if (ch < kN3DSManualChapterCount - 1) go(ch + 1); }
+		if (down & KEY_L) { if (ch > 0) go(ch - 1); }
+		if (down & KEY_A) { press(sel); if (sel == kBtnOpts) action = 1; else if (sel == kBtnSwap) action = 2; }
+		if (down & KEY_TOUCH) {
+			touchPosition tp; hidTouchRead(&tp);
+			if (tp.py >= 240 - 32) { const int id = tp.px < 160 ? kBtnSwap : kBtnOpts; press(id); action = id == kBtnOpts ? 1 : 2; }
+			else { const int i = ((int)tp.py - 20) / 14; if (tp.py >= 20 && i >= 0 && i < kN3DSManualChapterCount) { press(i); go(i); } }
+		}
+		DrawManualTop(scroll, lines);
+		DrawManualBottom(ch, sel, pressFrames > 0 ? pressed : -1);
+		gfxFlushBuffers(); gfxSwapBuffers(); gspWaitForVBlank();
+		if (pressFrames > 0 && --pressFrames == 0 && action) break;
+	}
+	while (aptMainLoop()) { // don't let the closing press leak into the game
+		hidScanInput();
+		if (!(hidKeysHeld() & (KEY_SELECT | KEY_B | KEY_START | KEY_TOUCH | KEY_A | KEY_CPAD_UP | KEY_CPAD_DOWN | KEY_CSTICK_UP | KEY_CSTICK_DOWN))) break;
+		gspWaitForVBlank();
+	}
+	if (action == 1) { PushKey(SDLK_o, true); PushKey(SDLK_o, false); }
+	if (action == 2) SetSwap(!g_swap);
+}
+
+extern int gN3DSCursorX, gN3DSCursorY; // kept in sync by Video.cc
+
+void N3DS_PumpInput()
+{
+	{ // memory trace every 3 s (console.txt) so a silent exit still leaves the last heap numbers behind
+		static u64 lastLog = 0;
+		const u64 now = svcGetSystemTick();
+		if (now - lastLog > 3ull * SYSCLOCK_ARM11) { lastLog = now; N3DS_LogMem("tick"); }
+	}
+	static u32 prev = 0;
+	static float fx = -1, fy = -1;
+	static bool firstRun = true;
+	const N3DSScreen scr = N3DS_CurrentScreen();
+	if (firstRun && scr == N3DS_SCR_MENU) {
+		firstRun = false;
+		struct stat sb;
+		if (stat(N3DS_DIR "/.manual_seen", &sb) != 0) {
+			if (FILE* f = fopen(N3DS_DIR "/.manual_seen", "w")) fclose(f);
+			N3DS_RunManual(1); // open on the Controls chapter the first time
+			prev = hidKeysHeld();
+		}
+	}
+	const u32 held = hidKeysHeld();
+	const u32 down = held & ~prev, up = prev & ~held;
+	if ((down & KEY_SELECT) && scr != N3DS_SCR_INTRO) {
+		N3DS_RunManual();
+		prev = hidKeysHeld();
+		return;
+	}
+	prev = held;
+
+	// intro videos: any button skips them
+	if (scr == N3DS_SCR_INTRO) {
+		if (down & ~(KEY_TOUCH)) { PushKey(SDLK_ESCAPE, true); PushKey(SDLK_ESCAPE, false); }
+		return;
+	}
+
+	// game on the top screen: the touch screen is the dashboard, its button swaps back
+	if (g_swap && (down & KEY_TOUCH)) {
+		touchPosition tp; hidTouchRead(&tp);
+		if (tp.py >= 240 - 24) { Click(); SetSwap(false); }
+	}
+
+	// ZL swaps the screens at any time. ZR: tap = cursor level ground / roof, hold 0.5 s = END TURN
+	if (down & KEY_ZL) { Click(); SetSwap(!g_swap); }
+	{
+		static u64 zrAt = 0; static bool zrFired = false;
+		if (down & KEY_ZR) { zrAt = osGetTime(); zrFired = false; }
+		if ((held & KEY_ZR) && !zrFired && osGetTime() - zrAt >= 500) { zrFired = true; PushKey(SDLK_d, true); PushKey(SDLK_d, false); }
+		if ((up & KEY_ZR) && !zrFired) { PushKey(SDLK_TAB, true); PushKey(SDLK_TAB, false); }
+	}
+	for (const KeyMap& m : kKeyMap) {
+		if (down & m.key) PushKey(m.sym, true);
+		if (up & m.key)   PushKey(m.sym, false);
+	}
+
+	if (fx < 0 || (held & (KEY_CPAD_UP|KEY_CPAD_DOWN|KEY_CPAD_LEFT|KEY_CPAD_RIGHT|KEY_CSTICK_UP|KEY_CSTICK_DOWN|KEY_CSTICK_LEFT|KEY_CSTICK_RIGHT)) == 0) {
+		fx = (float)gN3DSCursorX; fy = (float)gN3DSCursorY;
+	}
+	circlePosition cp, cs;
+	hidCircleRead(&cp);
+	hidCstickRead(&cs);
+	int dx = cp.dx + cs.dx, dy = cp.dy + cs.dy;
+	static u64 lastTick = 0;
+	const u64 now = svcGetSystemTick();
+	float frames = lastTick ? (float)(now - lastTick) / (float)(SYSCLOCK_ARM11 / 60) : 1.0f;
+	lastTick = now;
+	if (frames > 4.0f) frames = 4.0f;
+	if (dx * dx + dy * dy > 15 * 15) {
+		const float k = (0.0012f * (float)(dx * dx + dy * dy) / 155.0f + 0.04f) * frames;
+		fx += dx * k; fy -= dy * k;
+		if (fx < 0) fx = 0; if (fx > 639) fx = 639;
+		if (fy < 0) fy = 0; if (fy > 479) fy = 479;
+		g_mx = (int)fx; g_my = (int)fy;
+		PushMouseMove();
+	} else {
+		g_mx = gN3DSCursorX; g_my = gN3DSCursorY;
+	}
+
+	if (down & KEY_A) PushMouseButton(SDL_BUTTON_LEFT, true);
+	if (up & KEY_A)   PushMouseButton(SDL_BUTTON_LEFT, false);
+	if (down & KEY_B) PushMouseButton(SDL_BUTTON_RIGHT, true);
+	if (up & KEY_B)   PushMouseButton(SDL_BUTTON_RIGHT, false);
+
+	if (!aptMainLoop()) {
+		printf("[3ds] aptMainLoop() returned false (the system asked the app to quit) -> SDL_QUIT\n");
+		SDL_Event e; SDL_zero(e); e.type = SDL_QUIT; SDL_PushEvent(&e);
+	}
+}
+#endif
