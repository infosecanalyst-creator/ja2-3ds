+// Nintendo 3DS platform glue for JA2 Stracciatella
+//
+// Screens: the game renders at 640x480 (RGB565).
+//   bottom (320x240, touch): the whole frame at exactly half size, so the stylus
+//                            maps 1:2 onto game coordinates (SDL touch -> game).
+//   top    (400x240):        a 1:1, readable window that follows the cursor.
+#ifdef JA2_3DS
+#include "N3DS_Platform.h"
+#include <3ds.h>
+#include <sys/types.h>
+#include <string.h>
+
+// devkitARM's libsysbase forwards pthread TLS keys to __syscall_tls_* hooks that
+// libctru does not provide, so pthread_key_create() always failed ("out of TLS keys"
+// from the Rust runtime). Implement them on top of compiler TLS (__thread).
+#include <errno.h>
+#include <pthread.h>
+#define N3DS_TLS_KEYS 128
+static volatile int g_tlsUsed[N3DS_TLS_KEYS];
+static __thread const void* t_tlsVals[N3DS_TLS_KEYS];
+extern "C" {
+int __syscall_tls_create(pthread_key_t* key, void (* /*dtor*/)(void*))
+{
+	for (int i = 1; i < N3DS_TLS_KEYS; ++i) { // key 0 is a sentinel for Rust's lazy keys
+		if (__atomic_exchange_n(&g_tlsUsed[i], 1, __ATOMIC_SEQ_CST) == 0) {
+			*key = (pthread_key_t)i;
+			return 0;
+		}
+	}
+	return EAGAIN;
+}
+int __syscall_tls_set(pthread_key_t key, const void* value)
+{
+	if ((unsigned)key >= N3DS_TLS_KEYS) return EINVAL;
+	t_tlsVals[key] = value;
+	return 0;
+}
+void* __syscall_tls_get(pthread_key_t key)
+{
+	return (unsigned)key < N3DS_TLS_KEYS ? (void*)t_tlsVals[key] : nullptr;
+}
+int __syscall_tls_delete(pthread_key_t key)
+{
+	if ((unsigned)key >= N3DS_TLS_KEYS) return EINVAL;
+	g_tlsUsed[key] = 0;
+	return 0;
+}
+}
+
+extern "C" {
+// Rust std (hashmap keys, tempfile) needs getrandom(); newlib/libctru do not provide it.
+ssize_t getrandom(void *buf, size_t len, unsigned int /*flags*/)
+{
+	static int psState = 0; // 0 = untried, 1 = ok, -1 = unavailable
+	if (psState == 0) psState = R_SUCCEEDED(psInit()) ? 1 : -1;
+	if (psState == 1 && R_SUCCEEDED(PS_GenerateRandomBytes(buf, len))) return (ssize_t)len;
+
+	static u64 x = 0;
+	if (x == 0) x = svcGetSystemTick() | 1;
+	u8 *p = (u8 *)buf;
+	for (size_t i = 0; i < len; ++i) {
+		x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+		p[i] = (u8)(x >> 32);
+	}
+	return (ssize_t)len;
+}
+}
