+// ---- memory: give malloc most of the application memory, keep a small linear heap (SDL/ndsp buffers)
+extern "C" {
+u32 __ctru_linear_heap_size = 16 * 1024 * 1024; // everything else (malloc heap) is the rest of the application memory
+u32 __stacksize__ = 1024 * 1024; // main thread stack (libctru default is 32 KB, far too small for JA2: overflow corrupted return addresses -> PC=0 crash)
+}
+void N3DS_LogMem(const char* tag)
+{
+	struct mallinfo mi = mallinfo();
+	printf("[mem] %s: app-free=%lu KB linear-free=%lu KB malloc-in-use=%d KB malloc-arena=%d KB\n", tag,
+	       (unsigned long)(osGetMemRegionFree(MEMREGION_APPLICATION) / 1024), (unsigned long)(linearSpaceFree() / 1024),
+	       mi.uordblks / 1024, mi.arena / 1024);
+}
+static void N3DS_NewHandler() { N3DS_LogMem("operator new FAILED"); throw std::bad_alloc(); }
+
+void N3DS_BootStatus(const char* fmt, ...)
+{
+	char msg[160];
+	va_list ap; va_start(ap, fmt); vsnprintf(msg, sizeof msg, fmt, ap); va_end(ap);
+	if (!g_bootT0) g_bootT0 = svcGetSystemTick();
+	const double secs = (double)(svcGetSystemTick() - g_bootT0) / SYSCLOCK_ARM11;
+	printf("[boot %7.2fs] %s\n", secs, msg);
+	if (g_bootDone || !gspHasGpuRight()) return;
+	static char lines[28][64]; static int n = 0;
+	if (n == 28) { memmove(lines[0], lines[1], sizeof(lines[0]) * 27); n = 27; }
+	snprintf(lines[n++], 64, "%6.1fs %s", secs, msg);
+	extern void N3DS_DrawBootLines(char (*l)[64], int n);
+	N3DS_DrawBootLines(lines, n);
+}
